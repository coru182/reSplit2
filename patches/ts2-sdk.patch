+    uint32_t port;
+    {
+        std::lock_guard<std::mutex> lock(g_ports_lock);
+        auto it = g_handles.find(a[0]);
+        if (it == g_handles.end()) return 6;  // ERROR_INVALID_HANDLE
+        port = it->second.port;
+    }
+    input::Pad p = input::Poll(int(port));
+    ApplyPadScript(int(port), p);
+    if (!p.connected) return 1167;  // ERROR_DEVICE_NOT_CONNECTED
+    // XINPUT_CAPABILITIES: SubType, Reserved, In.Gamepad (buttons, 8 analog buttons, 4 thumb axes), Out.Rumble
+    uint8_t caps[26] = {};
+    caps[0] = 1;  // XINPUT_DEVSUBTYPE_GC_GAMEPAD
+    caps[4] = 0xFF;
+    for (int i = 6; i < 26; i++) caps[i] = 0xFF;
+    std::memcpy(HostPtr(a[1]), caps, sizeof(caps));
+    return 0;
+}
